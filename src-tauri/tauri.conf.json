{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Zetla",
    "version": "0.1.4",
    "identifier": "com.burce.zetla",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Zetla",
                "width": 1280,
                "height": 720
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "active": false,
        "publisher": "Max",
        "targets": [
            "nsis"
        ],
        "resources": [
            "templates"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "languages": [
                    "SimpChinese",
                    "English"
                ],
                "installerHooks": "windows/nsis-hooks.nsh"
            }
        }
    }
}
